#!/bin/bash
# Weekly: prune and check the stage-1 repo, warn about old backups.
. /usr/local/lib/nas-backup/common.sh

with_lock
rc=0
now=$(date +%s)

restic forget --tag nas --group-by host,tags "${RESTIC_KEEP[@]}" --prune || rc=$?
restic check --read-data-subset "$CHECK_SUBSET" || rc=$?

last=$(latest_snapshot_epoch)
if [ $((now - last)) -gt $((BACKUP_MAX_AGE_H * 3600)) ]; then
	echo "Newest snapshot is older than ${BACKUP_MAX_AGE_H} h: $([ "$last" = 0 ] && echo none || date -d "@$last")" >&2
	rc=1
fi

# Reminder, not an error: the offsite disk is due.
if [ -f "$STATE_DIR/last-offsite" ]; then
	lo=$(date -d "$(cat "$STATE_DIR/last-offsite")" +%s)
	days=$(((now - lo) / 86400))
else
	days=-1
fi
if [ "$days" -lt 0 ] || [ "$days" -gt "$OFFSITE_MAX_AGE_D" ]; then
	notify "Offsite-Platte fällig" <<EOF
Der letzte Abgleich mit der Offsite-Platte ($OFFSITE_LABEL) ist $([ "$days" -lt 0 ] && echo "noch nie gelaufen" || echo "$days Tage her").

Bitte die Platte an den NAS anstecken. Der Abgleich startet von selbst,
per Mail kommt «läuft» und dann «fertig, Platte kann abgezogen werden».
EOF
fi

exit "$rc"
